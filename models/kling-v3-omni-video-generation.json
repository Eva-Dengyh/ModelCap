{
  "model_id": "kling-v3-omni-video-generation",
  "provider": "aliyun",
  "version": "v3",
  "fetched_at": "2026-09-01",
  "source_url": "https://help.aliyun.com/en/model-studio/kling-video-generation-api-reference/",
  "ability": {
    "tasks": ["generate", "edit"],
    "inputs": ["reference_video", "reference_image"],
    "audio": true,
    "note": "Kling v3 Omni（可灵 v3），经阿里云百炼 Model Studio 提供。支持文生/首帧/首尾帧/参考生视频与视频编辑。同系列另有 v3（无参考生视频/编辑）、v3-turbo（无 4k、仅首帧）。"
  },
  "input_limits": {
    "max_reference_images": 7,
    "max_reference_videos": 1,
    "image": {
      "max_bytes": 10485760,
      "formats": ["jpeg", "png"],
      "min_side_px": 300,
      "max_side_px": 8000,
      "min_ratio": 0.4,
      "max_ratio": 2.5
    },
    "video": {
      "min_duration_seconds": 3,
      "max_duration_seconds": 15,
      "formats": ["mp4", "mov"]
    }
  },
  "rules": {
    "generate": {
      "duration_seconds": { "min": 3, "max": 15 },
      "resolution": ["720p", "1080p", "4k"],
      "aspect_ratio": ["16:9", "9:16", "1:1"],
      "ratio_mode": "client_choice",
      "duration_mode": "client_choice",
      "generate_audio": true,
      "note": "mode: std(720P)/pro(1080P)/4k；duration 3~15s（feature 参考视频时 3~10s），默认 5；audio 默认 false（静音）；首帧/首尾帧场景 aspect_ratio 可不设（继承首帧图）；图片 JPEG/JPG/PNG（无 alpha）；视频 3~15.5s、FPS 24~60、≤200MB。"
    },
    "edit": {
      "duration_seconds": -1,
      "resolution": ["720p", "1080p", "4k"],
      "aspect_ratio": ["16:9", "9:16", "1:1"],
      "ratio_mode": "inherit_from_reference_video",
      "duration_mode": "inherit_from_reference_video",
      "generate_audio": true,
      "note": "视频编辑（base）：输出时长/宽高比继承输入视频，duration 参数被忽略；base 1 个视频，refer 参考图+实体 ≤4；传入视频时 audio 只能 false。"
    }
  },
  "output_limits": {
    "max_duration_seconds": 15,
    "aspect_ratio_mode": "client_choice"
  },
