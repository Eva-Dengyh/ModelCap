      "resolution": ["720p", "1080p"],
      "aspect_ratio": ["16:9", "9:16"],
      "ratio_mode": "client_choice",
      "duration_mode": "client_choice",
      "generate_audio": true,
      "note": "duration 仅支持 4/6/8 三档（默认 8）；resolution 默认 1080p；generate_audio 默认 true；输入图片需 720p 或更高分辨率。"
    }
  },
  "output_limits": {
    "max_duration_seconds": 8,
    "aspect_ratio_mode": "client_choice"
  },
  "errors": {
    "_missing": true,
    "note": "本页未提供错误码表；响应含 error 对象但无具体错误码枚举。"
  }
