  "source_url": "https://docs.aimlapi.com/api-references/video-models/google/veo-3-1-image-to-video",
  "ability": {
    "tasks": ["generate"],
    "inputs": ["reference_image"],
    "audio": true,
    "note": "Google Veo 3.1 image-to-video（模型标识 google/veo-3.1-i2v），经 AIML API 提供。生成 8 秒 720p/1080p 视频，带音频，支持多风格与对白。"
  },
  "input_limits": {
    "max_reference_images": 1,
    "image": { "_missing": true }
  },
  "rules": {
