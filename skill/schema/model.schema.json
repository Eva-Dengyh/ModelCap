{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://model-catalog.dev/schema/model.schema.json",
  "title": "AI Model Capability Catalog",
  "description": "一个模型版本一个 JSON 条目。JSON 是唯一事实源；markdown 由本文件渲染生成，禁止手写第二份。缺失字段必须为 null 并打 _missing 标，禁止编造。",
  "type": "object",
  "if": { "required": ["_missing"] },
  "then": {
    "required": ["model_id", "provider", "version", "fetched_at", "source_url", "ability"]
  },
  "else": {
    "required": ["model_id", "provider", "version", "fetched_at", "source_url", "ability", "input_limits", "rules", "errors"]
  },
  "properties": {
    "_missing": {
      "type": "array",
      "items": { "type": "string" },
      "description": "骨架标记：列出尚未补全的顶层块名（如 input_limits/rules/errors/output_limits/pricing）。带 _missing 的条目是骨架，只要求身份五项 + ability；补全后应删除本字段。"
    },
    "model_id": {
      "type": "string",
      "description": "唯一标识，版本编进 id，如 seedance-2-5、kling-v2。不同版本 = 不同文件。"
    },
    "provider": {
      "type": "string",
      "description": "供应商：volcengine / kling / minimax / wan / ..."
    },
    "version": {
      "type": "string",
      "description": "模型版本号，如 2.5。与 model_id 保持一致。"
    },
    "fetched_at": {
      "type": "string",
      "format": "date",
      "description": "本次核实的日期（YYYY-MM-DD）。信息会过期，靠它判断新鲜度。"
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "description": "官方文档链接，可追溯。"
    },

    "ability": {
      "type": "object",
      "description": "这个模型能干什么、接受什么输入。",
      "required": ["tasks", "inputs"],
      "properties": {
        "tasks": {
          "type": "array",
          "description": "支持的任务类型。不同任务参数规矩不同（见 rules）。",
          "items": { "enum": ["generate", "edit", "extend"] }
        },
        "inputs": {
          "type": "array",
          "description": "接受的输入类型。",
          "items": { "enum": ["reference_video", "reference_image", "audio"] }
        },
        "audio": {
          "type": "boolean",
          "description": "是否支持生成音频。"
        },
        "scenes": {
          "type": "array",
          "description": "生成场景（generate 任务的细分）。",
          "items": { "enum": ["t2v", "i2v-first-frame", "i2v-first-last-frame", "i2v-middle-frame", "r2v"] }
        },
        "capabilities": {
          "type": "array",
          "description": "特色能力。",
          "items": { "enum": ["lip-sync", "multi-shot", "camera-control"] }
        },
        "note": { "type": "string" }
      }
    },

    "input_limits": {
      "type": "object",
      "description": "输入素材的硬性约束。超限直接拒绝，这是校验的第一道关。",
      "properties": {
        "reference_videos": {
          "type": "object",
          "description": "参考视频数量范围（常见恰好 1 条）。",
          "properties": {
            "min": { "type": "integer" },
            "max": { "type": "integer" }
          }
        },
        "max_reference_images": { "type": ["integer", "null"] },
        "max_reference_videos": { "type": ["integer", "null"] },
        "max_reference_audios": { "type": ["integer", "null"] },
        "max_reference_materials": {
          "type": ["integer", "null"],
          "description": "素材合计上限（图 + 视频）。"
        },
        "image": {
          "type": "object",
          "description": "图片硬性约束。",
          "properties": {
            "max_bytes": { "type": ["integer", "null"] },
            "formats": { "type": ["array", "null"], "items": { "enum": ["jpeg", "jpg", "png", "webp", "bmp", "tiff", "gif", "heic", "heif", "jxl"] } },
            "min_side_px": { "type": ["integer", "null"] },
            "max_side_px": { "type": ["integer", "null"] },
            "min_ratio": { "type": ["number", "null"] },
            "max_ratio": { "type": ["number", "null"] }
          }
        },
        "video": {
          "type": "object",
          "description": "参考视频约束。",
          "properties": {
            "min_duration_seconds": { "type": ["number", "null"] },
            "max_duration_seconds": { "type": ["number", "null"] },
            "formats": { "type": ["array", "null"], "items": { "type": "string" } }
          }
        },
        "additional_prompt": {
          "type": "object",
          "properties": {
            "max_chars": { "type": ["integer", "null"] }
          }
        }
      }
    },

    "rules": {
      "type": "object",
      "description": "参数规矩，按任务类型分。核心防坑点：同一参数在不同任务下约束可能不同（如编辑任务时长强制 -1）。",
      "properties": {
        "_missing": true,
        "note": { "type": "string" }
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "supported_parameters": {
            "type": "array",
            "description": "该任务 API 接受的参数名列表（如 duration/resolution/aspect_ratio/generate_audio），供客户端快速判断可传哪些参数。",
            "items": { "type": "string" }
          },
          "duration_seconds": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "min": { "type": ["number", "null"] },
                  "max": { "type": ["number", "null"] },
                  "step": { "type": ["number", "null"] }
                }
              },
              {
                "const": -1,
                "description": "固定 -1 = 由服务端决定，客户端禁止自定义。"
              },
              { "type": "null", "description": "官方未给出该任务的时长约束。" }
            ]
          },
          "resolution": { "type": ["array", "null"], "items": { "enum": ["360p", "480p", "540p", "720p", "768p", "1080p", "2k", "4k"] } },
          "aspect_ratio": { "type": ["array", "null"], "items": { "type": "string", "pattern": "^\\d+:\\d+$|^adaptive$" } },
          "ratio_mode": { "enum": ["inherit_from_reference_video", "client_choice", null] },
          "duration_mode": { "enum": ["inherit_from_reference_video", "client_choice", "explicit", null] },
          "generate_audio": { "type": ["boolean", "null"] },
          "audio": {
            "type": "object",
            "description": "音频参数（支持音频的模型才有）。",
            "properties": {
              "max_reference_audios": { "type": ["integer", "null"] },
              "extra_charge": { "type": ["boolean", "null"] }
            }
          },
          "note": { "type": "string" }
        }
      }
    },

    "output_limits": {
      "type": ["object", "null"],
      "description": "输出（成片）约束。null = 官方未给出输出限制。",
      "properties": {
        "max_duration_seconds": { "type": ["number", "null"] },
        "aspect_ratio_mode": { "enum": ["inherit_from_reference_video", "client_choice"] }
      }
    },

    "rankings": {
      "type": "array",
      "description": "外部评测榜单快照（Artificial Analysis / LMArena Video Arena）。一条模型可有多行：不同榜单、不同分辨率档/变体。榜单分数与价格会过期，以每行 as_of 为准。rankings 是第三方评测口径，与 pricing（厂商计费）无关。",
      "items": {
        "type": "object",
        "required": ["board", "label", "score", "as_of", "url"],
        "properties": {
          "board": {
            "enum": ["aa-i2v", "aa-t2v", "aa-video-edit", "lmarena-i2v", "lmarena-t2v", "lmarena-video-edit"]
          },
          "label": { "type": "string", "description": "榜单上显示的模型/档位名，如 'Kling 3.0 1080p (Pro)'。" },
          "rank": { "type": ["integer", "null"], "description": "该榜排名。" },
          "score": { "type": "number", "description": "AA=Elo / LMArena=Arena score，两个体系不可直接比较。" },
          "ci": { "type": ["integer", "null"], "description": "95% 置信区间 ±值。" },
          "samples": { "type": ["integer", "null"], "description": "AA Samples 或 LMArena Votes。" },
          "release_date": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$", "description": "榜单标注的发布日期。榜单常只给到年月（YYYY-MM），也可精确到日。" },
          "open_weights": { "type": ["boolean", "null"], "description": "仅在榜单明确标注开放权重/开源许可时置 true，否则留 null（不推断闭源）。" },
          "price_usd_per_min": { "type": ["number", "null"], "description": "AA 'API 价格' 口径：用模型创建者 API 默认设置生成 1 分钟 1080p 视频的美元成本；'即将推出' 为 null。" },
          "as_of": { "type": "string", "format": "date", "description": "该榜单快照日期。" },
          "url": { "type": "string", "format": "uri", "description": "该榜单页面链接。" }
        }
      }
    },

    "pricing": {
      "type": ["object", "null"],
      "description": "价格信息。单独字段便于常改。null = 官方未提供价格。",
      "properties": {
        "currency": { "enum": ["CNY", "USD"] },
        "unit": { "enum": ["second", "minute", "request", "image", "video", "character", "pixel", "token"] },
        "tiers": {
          "type": "object",
          "description": "按档位（清晰度或时长档）分档单价。数字可为整数（积分/秒等点数体系）或小数（如 CNY 元/秒、USD/条）。",
          "additionalProperties": { "type": ["integer", "number"] }
        },
        "observed_at": { "type": "string", "format": "date", "description": "价格快照日期。价格会变，以它为准。" },
        "source": { "type": "string", "format": "uri", "description": "价格来源链接。" },
        "note": { "type": "string" }
      }
    },

    "errors": {
      "type": "object",
      "description": "私有错误码 → 标准语义 → 给用户的话。代码只认 standard，不认供应商私有码。",
      "properties": {
        "_missing": true,
        "note": { "type": "string" }
      },
      "additionalProperties": {
        "type": "object",
        "required": ["standard"],
        "properties": {
          "standard": {
            "enum": [
              "content_violation.real_person",
              "content_violation.safety",
              "content_violation.audio",
              "content_violation.copyright",
              "invalid_parameter",
              "quota_exceeded",
              "timeout",
              "interrupted",
              "access_denied",
              "provider_failed",
              "output_processing_failed",
              "settlement_failed"
            ]
          },
          "user_message": { "type": "string" }
        }
      }
    }
  }
}
